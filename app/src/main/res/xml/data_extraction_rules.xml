<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 (API 31) and higher. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- CRM / webhook API tokens must never leave the device. -->
        <exclude domain="sharedpref" path="crm_integrations.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="crm_integrations.xml" />
    </device-transfer>
</data-extraction-rules>
